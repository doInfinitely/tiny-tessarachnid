# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

@dataclass
class TesseractConfig:
    # Character → Word chaining (narrow forward cone)
    # Tuned via GPT-2 perplexity on 8 PDF pages — see git history.
    char_scan_angle_deg: float = 15.0   # half-angle of forward scan cone
    char_max_distance_px: float = 0.0   # max gap between char centers
                                        # (0 = auto: 1.5 × median char width)
    char_angle_weight: float = 0.3      # penalty weight for angle deviation
    char_distance_weight: float = 0.7   # penalty weight for distance
    char_max_vertical_px: float = 0.0   # max vertical distance between char centers
                                        # (0 = auto: 0.5 × median char height)

    # Word → Line grouping (y-center band clustering)
    line_band_factor: float = 0.5       # line band half-width as fraction of median
                                        # word height; words within this band merge

    # Line → Paragraph chaining (wider downward cone)
    line_scan_angle_deg: float = 45.0
    line_max_distance_px: float = 100.0
    line_angle_weight: float = 0.4
    line_distance_weight: float = 0.6

    # Paragraph grouping
    para_vertical_gap_factor: float = 3.0  # max gap as multiple of avg line height

    # Detector settings
    min_confidence: int = 30              # minimum confidence (0-100)


# ---------------------------------------------------------------------------
# Character detection via Tesseract
# ---------------------------------------------------------------------------

@dataclass
class CharBox:
    bbox: list  # [x1, y1, x2, y2]
    char: str
    confidence: float

    @property
    def cx(self):
        return (self.bbox[0] + self.bbox[2]) / 2.0

    @property
    def cy(self):
        return (self.bbox[1] + self.bbox[3]) / 2.0

    @property
    def width(self):
        return self.bbox[2] - self.bbox[0]

    @property
    def height(self):
        return self.bbox[3] - self.bbox[1]
